# Mfano wa chagua (switch/case)
# Kumbuka: tofauti na lugha nyingine, chagua ndani ya Swap
# husimama papo hapo baada ya "kesi" inayolingana kutekelezwa,
# hivyo neno "vunja" halihitajiki (na si sahihi) ndani ya chagua.
hifadhi siku = 3;

chagua (siku) {
    kesi 1:
        andika "Jumatatu";
    kesi 2:
        andika "Jumanne";
    kesi 3:
        andika "Jumatano";
    zaidi:
        andika "Siku haijulikani";
}
