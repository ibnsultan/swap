# Mfano wa helper kazi mpya: math, array, string, aina, na json

# math_helpers
andika zungusha(4.5);
andika sakafu(4.9);
andika paa(4.1);
andika kamili(-7);
andika kubwa(3, 7, 2);
andika ndogo(3, 7, 2);
andika kipeo(2, 10);
andika mzizi(9);

# array_helpers
hifadhi namba = [1, 2, 3];
andika ongeza(namba, 4);
andika toa(namba);
andika panga([10, 2, 33, 4]);
andika unganisha(["moja", "mbili", "tatu"], "-");
andika geuza([1, 2, 3]);
andika kata([1, 2, 3, 4, 5], 1, 3);

# string_helpers
andika pogoa("  habari  ");
andika jaza("5", 3, "0");
andika gawa("moja,mbili,tatu", ",");

# type_helpers na json_helpers
andika ainaYa(5);
andika ainaYa("habari");
andika ainaYa([1, 2]);
andika kwaJson([1, 2, 3]);
