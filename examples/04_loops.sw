# Mfano wa vitanzi (loops): wakati na hakika
andika "--- kitanzi cha wakati ---";
hifadhi i = 0;
wakati (i < 5) {
    andika "Hesabu ya wakati: " + i;
    hifadhi i = i + 1;
}

andika "--- kitanzi cha hakika ---";
hakika (hifadhi j = 0; j < 5; hifadhi j = j + 1) {
    andika "Hesabu ya hakika: " + j;
}
